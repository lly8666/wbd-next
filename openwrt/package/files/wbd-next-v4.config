# Disabled until real credentials, interface and matching SOURCE are provided.
# Files must be regular, owner-only 0600; no secret bytes in this UCI file.
config client 'client'
    option enabled '0'
    option raw_interface ''
    option local_ip ''
    option peer_ip ''
    option local_port '50001'
    option peer_port '443'
    option tun_ip ''
    option server_name ''
    option username ''
    option route_key_file '/etc/wbd-next/route-key.hex'
    option password_file '/etc/wbd-next/password'
    option tunnel_id ''
